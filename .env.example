# Copy this file to .env and fill in the two Adzuna values at minimum.
# `docker compose up` reads .env automatically - nothing else to configure.

# --- Job connectors --------------------------------------------------------
# Free signup: https://developer.adzuna.com/  (required - the primary connector)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Free API key on request: https://jooble.org/api/about  (optional - second connector)
# Leave blank to run with Adzuna only; JoobleConnector logs a warning and no-ops if unset.
JOOBLE_API_KEY=

# How often JobAggregator re-polls every saved search, in minutes.
AGGREGATOR_POLL_INTERVAL_MINUTES=10

# --- Infrastructure (fine to leave as-is for local/dev) --------------------
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar

RABBITMQ_USER=jobradar
RABBITMQ_PASSWORD=jobradar
