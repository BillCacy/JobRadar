# Copy this file to .env and fill in the two Adzuna values at minimum.
# `docker compose up` reads .env automatically - nothing else to configure.

# --- Job connectors --------------------------------------------------------
# Free signup: https://developer.adzuna.com/  (required - the primary connector)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Free API key on request: https://jooble.org/api/about  (optional - second connector)
# Leave blank to run with Adzuna only; JoobleConnector logs a warning and no-ops if unset.
JOOBLE_API_KEY=

# How often JobAggregator re-polls every saved search, in minutes.
AGGREGATOR_POLL_INTERVAL_MINUTES=10

# --- Infrastructure (fine to leave as-is for local/dev) --------------------
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
POSTGRES_DB=jobradar

RABBITMQ_USER=jobradar
RABBITMQ_PASSWORD=jobradar

# --- Azure deploy (only needed for deploy/azure/deploy.sh - see docs/azure-hosting.md) -----
# Resource group + region the Bicep template deploys into. Created if it doesn't exist.
RESOURCE_GROUP=jobradar-rg
# Some regions (eastus in particular) are commonly restricted for new Postgres Flexible Server
# provisioning on trial/free subscriptions - if deployment fails with a "Version should be in: []"
# / "Provisioning is restricted in this region" error, try eastus2, centralus, or westus2.
LOCATION=eastus2

# Where deploy.sh pushes images before deploying, e.g. ghcr.io/yourusername.
# `docker login ghcr.io` first (or point this at your own registry).
CONTAINER_REGISTRY=
IMAGE_TAG=latest

# Azure Postgres Flexible Server admin password - separate from POSTGRES_PASSWORD above since
# Azure enforces its own complexity rules; pick something that meets them.
POSTGRES_ADMIN_PASSWORD=

# Reuses the same ADZUNA_APP_ID / ADZUNA_APP_KEY / JOOBLE_API_KEY values already set above -
# nothing further needed unless you want different keys for the cloud deploy.
